model Service {
  id                          Int                                @id @default(autoincrement())
  service_id                  String?                            @unique // float-like IDs should be stored as string
  department_id               Int?
  department                  Department?                        @relation(fields: [department_id], references: [id], onDelete: Cascade)
  issuer_id                   Int?
  issuer                      Issuer?                            @relation(fields: [issuer_id], references: [id], onDelete: SetNull)
