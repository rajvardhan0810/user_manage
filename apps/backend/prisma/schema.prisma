generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS (VALID PRISMA ENUMS)
// ------------------------------------------------------

enum user_type {
  INVESTOR
  DEPARTMENT
  CIS_USER
  INSPECTOR
  THIRD_PARTY

  @@map("user_type")
}

enum user_token_type {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("user_token_type")
}

enum user_log_type {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REGISTER
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  @@map("user_log_type")
}

enum payment_status_code {
  F
  S

  @@map("payment_status_code")
}

enum YnFlag {
  Y
  N

  @@map("yn_flag")
}

enum OptionSourceType {
  STATIC
  MASTER
}

// Tenant ka subscription plan
enum TenantPlan {
  FREE // limited features
  STANDARD // standard government use
  ENTERPRISE // full features + custom modules

  @@map("tenant_plan")
}

// Kis portal ka menu hai
enum ModulePortal {
  ADMIN // admin panel sidebar
  DEPARTMENT // department officer sidebar
  INVESTOR // investor/applicant sidebar

  @@map("module_portal")
}

// Permission action types
enum PermissionAction {
  CREATE // naya record banana
  READ // dekhna / list
  UPDATE // edit karna
  DELETE // delete karna
  EXPORT // CSV/PDF export
  APPROVE // application approve karna
  REJECT // application reject karna
  MANAGE // full control (CREATE+READ+UPDATE+DELETE)

  @@map("permission_action")
}

// Permission ka effect
enum PermissionEffect {
  ALLOW // permission di gayi hai
  DENY // permission specifically block ki gayi hai

  @@map("permission_effect")
}

// Geographic scope type
enum ScopeType {
  STATE // poore state ka access
  DISTRICT // specific district
  BLOCK // specific block
  TEHSIL // specific tehsil
  CIRCLE // specific circle (revenue/forest)
  DIVISION // specific division
  VILLAGE // specific village
  PROJECT // specific project ka access

  @@map("scope_type")
}

// Transfer ka reason
enum TransferReason {
  PROMOTION // promotion pe naya role mila
  TRANSFER // ek jagah se dusri jagah
  DEPUTATION // temporary posting
  RETIREMENT // retire ho gaye
  RESIGNATION // resign kar diya
  ADMIN_CHANGE // admin ne manually change kiya

  @@map("transfer_reason")
}

// ------------------------------------------------------
// USERS
// ------------------------------------------------------
model users {
  id                BigInt             @id @default(autoincrement())
  email             String?            @db.VarChar(255)
  password_hash     String?            @map("password_hash")
  salt              String?            @db.VarChar(255)
  password_algo     String             @default("argon2") @db.VarChar(50)
  user_type         user_type          @default(INVESTOR)
  role_id           Int? // Foreign key to roles table
  tenant_id         Int? // NULL = super admin, Value = tenant-specific user
  is_email_verified Int                @default(0) @db.SmallInt
  last_login_at     DateTime?          @db.Timestamptz(6)
  deleted_at        DateTime?          @db.Timestamptz(6)
  investor_profile  investor_profiles?
  department_user   department_users?
  user_tokens       user_tokens[]
  user_logs         user_logs[]

  // Relation to roles - CRITICAL for RBAC
  role                roles?               @relation(fields: [role_id], references: [id])
  tenant              Tenant?              @relation(fields: [tenant_id], references: [id])
  investorDocuments   InvestorDocument[]
  thirdPartyInspector ThirdPartyInspector?
  assignments         UserRoleAssignment[]

  @@map("users")
}

// ------------------------------------------------------
// COUNTRY
// ------------------------------------------------------

model Country {
  id            Int      @id @default(autoincrement())
  name          String
  abbreviation  String?
  boCountryId   Int?
  lrId          Int?
  hadbastNumber Int?
  vtcCode       Int?
  isActive      Boolean  @default(true)
  states        State[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("m_countries")
}

// ------------------------------------------------------
// USER LOGS
// ------------------------------------------------------

model user_logs {
  id          BigInt        @id @default(autoincrement())
  user_id     BigInt?
  user_type   user_type
  email       String?       @db.VarChar(255)
  log_type    user_log_type
  description String?       @db.Text
  ip_address  String?       @db.VarChar(45)
  user_agent  String?       @db.VarChar(512)
  session_id  String?       @db.VarChar(128)
  token_id    BigInt?
  metadata    Json?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  user  users?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  token user_tokens? @relation(fields: [token_id], references: [id])

  @@index([user_id], map: "idx_user_logs_user_id")
  @@index([log_type], map: "idx_user_logs_log_type")
  @@index([created_at], map: "idx_user_logs_created_at")
  @@map("user_logs")
}

// ------------------------------------------------------
// STATE
// ------------------------------------------------------

model State {
  id           Int        @id @default(autoincrement())
  name         String
  abbreviation String?
  countryId    Int
  country      Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  boStateId    Int?
  boLgdId      Int?
  stateCode    Int?
  isActive     Boolean    @default(true)
  districts    District[]
  blocks       Block[]
  tehsils      Tehsil[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents DocumentMaster[]

  @@map("m_states")
}

// ------------------------------------------------------
// DISTRICT
// ------------------------------------------------------

model District {
  id           Int      @id @default(autoincrement())
  name         String
  stateCode    String?  @db.VarChar(255)
  districtCode String?  @db.VarChar(255)
  stateId      Int
  state        State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  abbreviation String?  @db.VarChar(255)
  latlong      String?  @db.VarChar(255)
  isActive     Boolean  @default(true)
  blocks       Block[]
  tehsils      Tehsil[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("m_districts")
}

model Block {
  id               Int      @id @default(autoincrement())
  name             String
  districtId       Int
  district         District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  stateId          Int
  state            State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  unitCategory     String?  @db.VarChar(10) // A, B, B+, C, D
  districtCode     String?  @db.VarChar(255)
  lgCodeDistrictId Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  regionMappings   MappingRegionCategories[]
  kyiIcCalculators KyiIcCalculator[]

  @@map("m_blocks")
}

model Tehsil {
  id              Int       @id @default(autoincrement())
  name            String
  districtId      Int
  stateId         Int
  subDistrictCode String?
  deptDivisionId  Int?
  lgDistrictId    Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  villages        Village[]

  // Relations
  district District @relation(fields: [districtId], references: [id])
  state    State    @relation(fields: [stateId], references: [id])

  @@map("m_tehsils")
}

model Village {
  id              Int      @id @default(autoincrement())
  name            String
  tehsilId        Int
  villageCode     String
  subDistrictCode String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tehsil Tehsil @relation(fields: [tehsilId], references: [id])

  @@map("m_villages")
}

model Department {
  id           Int      @id @default(autoincrement())
  name         String
  uniqueTag    String   @unique
  ip           String
  secretKey    String
  baseUrl      String
  publicKey    String
  abbreviation String
  boDeptId     Int?
  order        Int?
  icon         String?
  deptType     Int      @default(2) // 1=central, 2=state
  tenant_id    Int? // NULL = platform-level, Value = tenant-specific
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  policies policy_master[]

  documentMasters   DocumentMaster[]
  issuer            Issuer?            @relation(fields: [issuerId], references: [id])
  issuerId          Int?
  tenant            Tenant?            @relation(fields: [tenant_id], references: [id])
  investorDocuments InvestorDocument[]

  services         Service[]
  kyiIcCalculators KyiIcCalculator[]
  actMappings      ActPolicyNotificationDepartment[]
  workflowConfigs  ApplicationWorkflowConfiguration[]

  @@map("m_departments")
}

model Issuer {
  id             Int      @id @default(autoincrement())
  name           String
  isIssuerActive Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  departments       Department[]
  documentMasters   DocumentMaster[]
  investorDocuments InvestorDocument[]
  services          Service[]

  @@map("m_issuers")
}

model DocumentType {
  id               Int      @id @default(autoincrement())
  name             String
  abbreviation     String
  isDocActive      Boolean  @default(true)
  isFormatRequired Boolean?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documentMasters   DocumentMaster[]
  investorDocuments InvestorDocument[]

  @@map("m_documenttypes")
}

model FormType {
  id              Int                                @id @default(autoincrement())
  name            String
  abbr            String                             @unique
  isActive        Boolean                            @default(true)
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  workflowConfigs ApplicationWorkflowConfiguration[]

  @@map("m_fb_form_types") // <-- Prisma expects this table name
}

model FormCategory {
  id           Int       @id @default(autoincrement())
  categoryName String    @map("category_name")
  nameInHindi  String?   @map("name_in_hindi")
  nameAlt      String?   @map("name") // legacy optional "name"
  parentId     Int       @default(0) @map("parent_id")
  categoryCode String    @unique @map("category_code")
  isActive     Boolean   @default(true) @map("is_active")
  created      DateTime? @map("created")
  modified     DateTime? @map("modified")

  // Relations
  fields FormField[] // <-- link to form fields

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("m_fb_form_categories")
}

model FormField {
  id          Int       @id @default(autoincrement())
  formCheckId String    @unique @map("formchk_id")
  parentId    Int       @default(0) @map("parent_id")
  categoryId  Int?      @map("category_id")
  name        String
  nameInHindi String?   @map("name_in_hindi")
  isEditable  String    @default("Y") @map("is_editable")
  createdDate DateTime? @map("created_date")
  isActive    Boolean   @default(true) @map("is_formvar_active")

  // NEW: proper relation to FormCategory (FK)
  category FormCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  formBuilderFields FormBuilderField[]

  @@index([parentId])
  @@map("m_fb_form_field")
}

model FormMapping {
  id            Int       @id @default(autoincrement())
  department_id Int
  service_id    String    @db.VarChar(10)
  form_type_id  Int
  form_name     String    @db.VarChar(255)
  form_code     String    @db.VarChar(255)
  form_version  String?   @db.VarChar(10)
  is_active     YnFlag    @default(Y)
  created       DateTime?
  modified      DateTime?

  service Service @relation("ServiceToFormMapping", fields: [service_id], references: [service_id])

  @@unique([department_id, service_id, form_type_id], map: "uniq_formmapping_dept_service_formtype")
  @@index([department_id])
  @@map("m_fb_form_mapping")
}

model FormPageMaster {
  id            Int       @id @default(autoincrement())
  service_id    String    @db.VarChar(255)
  page_name     String    @db.VarChar(255)
  is_active     YnFlag    @default(Y)
  name_in_hindi String?   @db.VarChar(255)
  preference    Int
  form_id       Int
  form_code     String?   @db.VarChar(250)
  created       DateTime?
  modified      DateTime?

  @@index([form_id])
  @@map("m_fb_page_master")
}

model FormPageCategoryMapping {
  id          Int     @id @default(autoincrement())
  page_id     Int
  category_id Int
  preference  Int
  help_text   String? @db.VarChar(500)
  is_active   YnFlag  @default(Y)

  @@index([page_id])
  @@map("m_fb_page_category_mapping")
}

model FormBuilderField {
  id          Int    @id @default(autoincrement())
  service_id  String
  form_id     Int
  page_id     Int
  category_id Int

  // Identification
  form_field_id Int
  preference    Int

  // Rendering Config
  input_type   String
  custom_label String?
  help_text    String?

  // ✅ NEW FIELDS (These were missing)
  placeholder     String?
  gridSpan        Int     @default(12) @map("grid_span")
  layoutType      String? @map("layout_type")
  component_props Json?   @map("component_props")

  // State
  is_required YnFlag @default(N)
  is_editable YnFlag @default(Y)
  is_readonly YnFlag @default(N)
  is_active   YnFlag @default(Y)

  // Validation (Legacy Columns + New JSON)
  min_length      Int?
  max_length      Int?
  pattern         String?
  step            String?
  row_type        String? // Kept for legacy compatibility
  validation_rule Json?

  created  DateTime  @default(now())
  modified DateTime?

  // Relations
  formField FormField @relation(fields: [form_field_id], references: [id], onDelete: Restrict)

  optionConfig          FormFieldOptionConfig?  @relation("BuilderFieldOptionConfig")
  optionConfigsAsParent FormFieldOptionConfig[] @relation("OptionParent")

  addMoreGroups      FormAddMoreGroup[]  @relation("TriggerBuilderField")
  formAddMoreColumns FormAddMoreColumn[]

  @@index([service_id, form_id, page_id, category_id])
  @@map("m_fb_form_builder_fields")
}

model FormFieldOptionConfig {
  id               Int              @id @default(autoincrement())
  builder_field_id Int              @unique
  source_type      OptionSourceType

  master_table_id         Int?
  static_options          Json?
  parent_builder_field_id Int?

  is_active YnFlag    @default(Y)
  created   DateTime  @default(now())
  modified  DateTime?

  // ✅ Relations
  builderField FormBuilderField @relation("BuilderFieldOptionConfig", fields: [builder_field_id], references: [id], onDelete: Cascade)

  masterTable master_tables? @relation(fields: [master_table_id], references: [id], onDelete: SetNull)

  // ✅ Cascading parent (points to builder field)
  parentBuilderField FormBuilderField? @relation("OptionParent", fields: [parent_builder_field_id], references: [id], onDelete: SetNull)

  @@map("m_fb_formfield_options")
}

model FormBuilderConfigValue {
  id        Int     @id @default(autoincrement())
  useFor    String? @map("use_for") @db.VarChar(255)
  fieldCode String? @map("field_code") @db.VarChar(255)
  tableName String? @map("table_name") @db.VarChar(255)
  serviceId String  @default("0") @map("service_id") @db.Char(20)
  rawQuery  String? @map("raw_query") @db.Text
  isActive  String  @default("t") @map("isActive") @db.Char(1)

  @@index([serviceId, isActive])
  @@index([useFor])
  @@map("m_fb_config_values")
}

model FormAddMoreGroup {
  id          Int    @id @default(autoincrement())
  service_id  String
  form_id     Int
  page_id     Int
  category_id Int

  trigger_builder_field_id Int
  label                    String?
  min_rows                 Int?    @default(1)
  max_rows                 Int?

  is_active YnFlag    @default(Y)
  created   DateTime  @default(now())
  modified  DateTime?

  // ✅ Relations
  triggerBuilderField FormBuilderField    @relation("TriggerBuilderField", fields: [trigger_builder_field_id], references: [id], onDelete: Cascade)
  columns             FormAddMoreColumn[]

  @@unique([service_id, form_id, page_id, category_id, trigger_builder_field_id], map: "uniq_addmore_group_scope")
  @@index([service_id, form_id, page_id, category_id])
  @@map("m_fb_addmore_groups")
}

model FormAddMoreColumn {
  id               Int @id @default(autoincrement())
  group_id         Int
  builder_field_id Int
  col_order        Int

  // ✅ Relations
  group        FormAddMoreGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  builderField FormBuilderField @relation(fields: [builder_field_id], references: [id], onDelete: Restrict)

  @@unique([group_id, builder_field_id], map: "uniq_addmore_column")
  @@index([group_id])
  @@map("m_fb_addmore_columns")
}

model FormRule {
  id         Int    @id @default(autoincrement())
  service_id String
  form_id    Int

  scope     String
  when_json Json
  then_json Json

  is_active YnFlag    @default(Y)
  created   DateTime  @default(now())
  modified  DateTime?

  @@index([service_id, form_id])
  @@map("m_fb_form_rules")
}

model DocumentCheckpoint {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  created   DateTime?
  modified  DateTime?
  filePath  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("m_document_checkpoints")
}

model DocumentMaster {
  id          Int    @id @default(autoincrement())
  checklistId String @unique

  // Foreign keys
  stateId        Int
  issuerId       Int
  departmentId   Int
  documentTypeId Int?
  issuerById     Int?

  // Document info
  checklistDocumentName      String
  checklistDocumentExtension String
  checklistDocumentMaxSize   Int

  // File management
  prescribedDocumentPath String?

  // New fields
  services                     Int[]   @default([])
  documentCheckpoints          Int[]   @default([])
  isMultiVersionAllowed        Boolean @default(false)
  isDocValidityRequired        Boolean @default(false)
  isDocReferenceNumberRequired Boolean @default(false)
  isAutoInsertAllowed          Boolean @default(false)
  isDocActive                  Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  state             State              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  issuer            Issuer             @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  documentType      DocumentType?      @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  investorDocuments InvestorDocument[]

  @@index([stateId])
  @@index([issuerId])
  @@index([departmentId])
  @@index([documentTypeId])
  @@index([createdAt])
  @@index([isDocActive])
  @@map("m_document_master")
}

model investor_profiles {
  id                 BigInt   @id @default(autoincrement())
  uid                String   @unique @db.VarChar(255)
  user_id            BigInt   @unique
  first_name         String   @db.VarChar(255)
  last_name          String?  @db.VarChar(64)
  pan_card           String?  @db.VarChar(16)
  adhaar_number      String?  @db.VarChar(12)
  country_name       String   @db.VarChar(64)
  state_name         String   @db.VarChar(64)
  city_name          String   @db.VarChar(64)
  district_name      String   @db.VarChar(100)
  pin_code           String   @db.VarChar(10)
  address            String   @db.Text
  mobile_number      BigInt
  legal_entity_name  String?  @db.VarChar(255)
  cons_pan_card      String?  @db.VarChar(255)
  cons_first_name    String?  @db.VarChar(255)
  cons_last_name     String?  @db.VarChar(255)
  cons_mobile_number String?  @db.VarChar(255)
  cons_email         String?  @db.VarChar(255)
  cons_country_name  String?  @db.VarChar(255)
  cons_state_name    String?  @db.VarChar(255)
  project_id         String?  @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  user              users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investorDocuments InvestorDocument[]

  @@map("investor_profiles")
}

model department_users {
  id                      BigInt   @id @default(autoincrement())
  user_id                 BigInt   @unique
  full_name               String   @db.VarChar(60)
  hindi_full_name         String?  @db.VarChar(255)
  email                   String   @db.VarChar(128)
  office_no               String?  @db.VarChar(15)
  mobile                  String?  @db.VarChar(16)
  dept_id                 Int
  district_id             Int?
  tahsil_id               Int      @default(0)
  circle_id               String?  @db.VarChar(255)
  block_id                Int      @default(0)
  office_id               Int      @default(0)
  division_id             Int      @default(0)
  delegate_officer_number String?  @db.VarChar(16)
  delegate_officer_name   String?  @db.VarChar(255)
  delegate_officer_email  String?  @db.VarChar(255)
  np_user_id              String?  @db.VarChar(255)
  is_for_testing          Int      @default(0) @db.SmallInt
  status                  Int      @default(1) @db.SmallInt
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("department_users")
}

model user_tokens {
  id         BigInt          @id @default(autoincrement())
  user_id    BigInt
  token_hash String          @unique @db.VarChar(128)
  token_type user_token_type
  expires_at DateTime        @db.Timestamptz(6)
  used_at    DateTime?       @db.Timestamptz(6)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  user       users?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs       user_logs[]

  @@map("user_tokens")
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  tenant_id   Int? // NULL = platform-level role, Value = tenant-specific
  parent_id   Int? // NULL = top-level role, Value = parent role id
  level       Int      @default(0) // Hierarchy depth
  description String? // Role ka kaam kya hai
  is_system   Boolean  @default(false) // true = cannot delete/rename
  updatedAt   DateTime @updatedAt

  // New relations
  tenant          Tenant?              @relation(fields: [tenant_id], references: [id])
  parent          roles?               @relation("RoleHierarchy", fields: [parent_id], references: [id])
  children        roles[]              @relation("RoleHierarchy")
  rolePermissions RolePermission[]
  assignments     UserRoleAssignment[]

  // Existing relations
  roleResources RoleResource[] @relation("RoleToRoleResource")
  users         users[]

  @@map("roles")
}

model resources {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(150)
  name       String   @db.VarChar(150)
  path       String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // FIX: point to PascalCase model and define back-relation name
  roleResources RoleResource[] @relation("ResourceToRoleResource")

  @@map("resources")
}

model RoleResource {
  id          BigInt @id @default(autoincrement())
  role_id     Int
  resource_id BigInt

  // FIX: name the relations so both sides are explicit & unambiguous
  role     roles     @relation("RoleToRoleResource", fields: [role_id], references: [id], onDelete: Cascade)
  resource resources @relation("ResourceToRoleResource", fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([role_id, resource_id], map: "uniq_role_resource")
  @@map("role_resources")
}

// ======================================================
// TENANT & MULTI-TENANCY TABLES
// ======================================================

// TABLE 1: Tenant
model Tenant {
  id Int @id @default(autoincrement())

  name          String
  slag          String     @unique
  domain        String?
  logo_url      String?
  primary_color String?
  plan          TenantPlan @default(STANDARD)
  settings      Json?
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  departments     Department[]
  roles           roles[]
  modules         Module[]
  users           users[]
  projects        TenantProject[]
  userAssignments UserRoleAssignment[]

  @@map("tenants")
}

// TABLE 2: TenantProject
model TenantProject {
  id Int @id @default(autoincrement())

  tenant_id   Int
  name        String
  code        String
  description String?
  start_date  DateTime?
  end_date    DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // Relations
  tenant      Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignments UserRoleAssignment[]

  @@unique([tenant_id, code])
  @@map("tenant_projects")
}

// TABLE 3: Module
model Module {
  id Int @id @default(autoincrement())

  tenant_id  Int?
  parent_id  Int?
  code       String       @unique
  name       String
  name_hindi String?
  route      String?
  icon       String?
  portal     ModulePortal
  order      Int          @default(0)
  is_leaf    Boolean      @default(true)
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  // Relations
  tenant      Tenant?      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent      Module?      @relation("ModuleHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children    Module[]     @relation("ModuleHierarchy")
  permissions Permission[]

  @@map("modules")
}

// TABLE 4: Permission
model Permission {
  id Int @id @default(autoincrement())

  module_id   Int
  action      PermissionAction
  description String?
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now())

  // Relations
  module          Module                             @relation(fields: [module_id], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  overrides       UserAssignmentPermissionOverride[]

  @@unique([module_id, action])
  @@map("permissions")
}

// TABLE 5: RolePermission
model RolePermission {
  id Int @id @default(autoincrement())

  role_id       Int
  permission_id Int
  effect        PermissionEffect @default(ALLOW)
  created_at    DateTime         @default(now())
  created_by    BigInt?

  // Relations
  role       roles      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

// TABLE 6: UserRoleAssignment
model UserRoleAssignment {
  id Int @id @default(autoincrement())

  user_id    BigInt
  role_id    Int
  tenant_id  Int
  project_id Int?

  valid_from          DateTime        @default(now())
  valid_until         DateTime?
  transfer_order_no   String?
  transfer_reason     TransferReason?
  transferred_from_id Int?
  assigned_by         BigInt?
  remarks             String?
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  // Relations
  user             users                              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role             roles                              @relation(fields: [role_id], references: [id], onDelete: Cascade)
  tenant           Tenant                             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project          TenantProject?                     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  transferred_from UserRoleAssignment?                @relation("TransferChain", fields: [transferred_from_id], references: [id], onDelete: SetNull)
  transfer_history UserRoleAssignment[]               @relation("TransferChain")
  scopes           UserAssignmentScope[]
  overrides        UserAssignmentPermissionOverride[]

  @@index([user_id, tenant_id, is_active])
  @@index([valid_from, valid_until])
  @@map("user_role_assignments")
}

// TABLE 7: UserAssignmentScope
model UserAssignmentScope {
  id Int @id @default(autoincrement())

  assignment_id Int
  scope_type    ScopeType
  scope_id      Int
  scope_label   String?
  created_at    DateTime  @default(now())

  // Relations
  assignment UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, scope_type, scope_id])
  @@map("user_assignment_scopes")
}

// TABLE 8: UserAssignmentPermissionOverride
model UserAssignmentPermissionOverride {
  id Int @id @default(autoincrement())

  assignment_id Int
  permission_id Int
  effect        PermissionEffect
  reason        String?
  created_at    DateTime         @default(now())
  created_by    BigInt?

  // Relations
  assignment UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, permission_id])
  @@map("user_assignment_permission_overrides")
}

