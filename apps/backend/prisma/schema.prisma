model master_tables {
  id Int @id @default(autoincrement())

  // Display & Identification
  master_name String  @db.VarChar(100) // "District Master"
  master_code String  @unique @db.VarChar(50) // "DISTRICT" - unique identifier
  description String? @db.Text // Optional description

  // Table Configuration
  table_name  String @db.VarChar(100) // "m_districts"
  schema_name String @default("public") @db.VarChar(50) // PostgreSQL schema

  // Column Mappings
  value_column String @db.VarChar(100) // "id" - column for dropdown value
  label_column String @db.VarChar(100) // "name" - column for dropdown label

  // Optional Additional Columns
  secondary_label String? @db.VarChar(100) // For composite labels (e.g., "code")
  label_template  String? @db.VarChar(255) // Template: "{name} ({code})"

  // Active/Status Configuration
  is_active_column String? @db.VarChar(100) // "isActive" - column for active filter
  is_active_value  String? @db.VarChar(50) // "true" or "Y" or "1"

  // Filtering & Ordering
  default_filter   Json?   @db.JsonB // {"departmentId": 5} - default filters
  default_order_by String? @db.VarChar(100) // "name ASC"

  // Parent Reference (for cascading dropdowns)
  parent_master_id Int?
  parent_column    String?         @db.VarChar(100) // "stateId" - column linking to parent
  parent_master    master_tables?  @relation("MasterHierarchy", fields: [parent_master_id], references: [id])
  child_masters    master_tables[] @relation("MasterHierarchy")

  // API Configuration
  api_endpoint String? @db.VarChar(255) // "/api/masters/districts"

  // Metadata
  is_active              Boolean                 @default(true)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @updatedAt @db.Timestamptz(6)
  created_by             String?                 @db.VarChar(100)
  formFieldOptionConfigs FormFieldOptionConfig[]

  @@map("master_tables")
}

