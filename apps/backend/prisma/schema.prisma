// ------------------------------------------------------
// INSPECTION MODULE
// ------------------------------------------------------

enum InspectionStatus {
  PENDING_ALLOCATION
  ALLOCATED
  SCHEDULED
  IN_PROGRESS
  OBSERVATIONS_LOGGED
  APPLICANT_RESPONSE_PENDING
  PENDING_APPROVAL
  FINALIZATION
  REPORT_PUBLISHED
  CLOSED
}

enum ObservationStatus {
  OPEN
  NEEDS_INFO
  RESOLVED
  CLOSED
  OVERRIDDEN
}

enum InspectorType {
  DEPARTMENT_OFFICIAL
  THIRD_PARTY
}

// 1. Checklist Definitions (Service-specific)
model InspectionChecklist {
  id        Int      @id @default(autoincrement())
  serviceId Int // Links to m_service
  service   Service  @relation(fields: [serviceId], references: [id])
  version   String   @default("1.0")
  isActive  Boolean  @default(true)
  validFrom DateTime @default(now())

  items       InspectionChecklistItem[]
  inspections InspectionTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, version])
  @@map("inspection_checklists")
}

model InspectionChecklistItem {
  id          Int                 @id @default(autoincrement())
  checklistId Int
  checklist   InspectionChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  type          String // PHOTO, VIDEO, DOCUMENT, TEXT
  isMandatory   Boolean @default(true)
  riskIndicator String? // HIGH, MED, LOW

  // Validation Rules (store as JSON for flexibility)
  validationRules Json? // { "min_photos": 1, "max_size_mb": 5 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inspection_checklist_items")
}

// 2. Third Party Inspectors (Profile)
model ThirdPartyInspector {
  id     Int    @id @default(autoincrement())
  userId BigInt @unique // Links to users table
  user   users  @relation(fields: [userId], references: [id])

  recognitionId String    @unique
  organization  String?
  validUntil    DateTime?
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED

  // Scope
  authorizedDistricts String[] // Array of district codes/IDs
  authorizedServices  Int[] // Array of service IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections InspectionTransaction[]

  @@map("third_party_inspectors")
}

// 3. Inspection Transactions
model InspectionTransaction {
  id            String  @id @default(uuid())
  applicationId String // Functional link to the Application (Submissions)
  serviceId     Int
  service       Service @relation(fields: [serviceId], references: [id])

  // CIS Enhancement: Link to Application Submission for unit details
  applicationSubmissionId Int?                   @map("application_submission_id")
  applicationSubmission   ApplicationSubmission? @relation(fields: [applicationSubmissionId], references: [submissionId])

  // CIS Enhancement: District for filtering
  districtId Int? @map("district_id")

  // Checklist Snapshot
  checklistId Int
  checklist   InspectionChecklist @relation(fields: [checklistId], references: [id])

  // Scheduling & Assignment
  status        InspectionStatus @default(SCHEDULED)
  scheduledDate DateTime

  inspectorType         InspectorType
  departmentInspectorId BigInt? // Link to department_users (userId)
  thirdPartyInspectorId Int?
  thirdPartyInspector   ThirdPartyInspector? @relation(fields: [thirdPartyInspectorId], references: [id])

  // CIS Enhancement: Inspection Type
  inspectionType String  @default("SINGLE") @map("inspection_type") // SINGLE, JOINT
  isThirdParty   Boolean @default(false) @map("is_third_party")

  // SWS Enhancement: Risk Category
  riskCategory String? // HIGH, MEDIUM, LOW

  // CIS Enhancement: Compliance Score (0-100)
  complianceScore Int? @map("compliance_score")

  // Execution Data
  inspectionDate    DateTime?
  completedAt       DateTime? @map("completed_at") // CIS: When inspection completed
  reportFinalizedAt DateTime?
  reportPublishedAt DateTime?
  reportUploadedAt  DateTime? // SWS: For SLA tracking (24hr rule)

  // SWS Enhancement: Applicant View Tracking
  applicantViewedAt DateTime? // When investor first viewed the report

  // SLA Tracking
  slaDueDate           DateTime? @map("sla_due_date") // CIS: SLA deadline
  slaBreachWarningSent Boolean   @default(false)
  slaBreached          Boolean   @default(false)

  // CIS Enhancement: Fee Details
  feeDetails     String?  @map("fee_details") // Description like "INR 5,000"
  totalFeeCharge Decimal? @map("total_fee_charge") @db.Decimal(12, 2) // Amount in INR
  feeStatus      String?  @default("PENDING") @map("fee_status") // PAID, PENDING, WAIVED

  // CIS Enhancement: Financial Year
  financialYear String? @map("financial_year") // "2025-2026"

  // AI Integration: Summary of completion
  aiSummary String? @map("ai_summary") @db.Text

  // Relations to existing models
  observations InspectionObservation[]

  // Relations to new SWS models
  evidence           InspectionEvidence[]
  checklistResponses InspectionChecklistResponse[]
  feedback           InspectionFeedback?
  auditLogs          InspectionAuditLog[]

  // JD Allocation Fields
  allocatedBy BigInt? // JD User ID who allocated
  allocatedAt DateTime?
  priority    String?   @default("NORMAL") // HIGH, NORMAL

  // Reschedule Request
  rescheduleRequested Boolean @default(false) @map("reschedule_requested")
  rescheduleReason    String? @map("reschedule_reason")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([riskCategory])
  @@index([applicationSubmissionId])
  @@index([districtId])
  @@index([financialYear])
  @@index([completedAt])
  @@map("inspection_transactions")
}

// 4. Observations & Responses
model InspectionObservation {
  id           String                @id @default(uuid())
  inspectionId String
  inspection   InspectionTransaction @relation(fields: [inspectionId], references: [id])

  checklistItemId Int? // Link to specific item if applicable

  observationText String
  severity        String // CRITICAL, MAJOR, MINOR
  status          ObservationStatus @default(OPEN)

  evidenceUrl String[] // Paths to functional evidence images/docs

  responses InspectionObservationResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inspection_observations")
}

model InspectionObservationResponse {
  id            String                @id @default(uuid())
  observationId String
  observation   InspectionObservation @relation(fields: [observationId], references: [id])

  responderId BigInt // User who responded
  message     String
  attachments String[]

  isInternal Boolean @default(false) // If true, it's inspector note, else applicant response

  createdAt DateTime @default(now())

  @@map("inspection_observation_responses")
}

// ------------------------------------------------------
// SWS INSPECTION ENHANCEMENTS
// ------------------------------------------------------

enum RiskCategory {
  HIGH
  MEDIUM
  LOW
}

// 5. Evidence Log (per checklist item or general)
model InspectionEvidence {
  id           String                @id @default(uuid())
  inspectionId String
  inspection   InspectionTransaction @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  checklistItemId Int? // Optional link to specific checklist item

  fileType String // PHOTO, VIDEO, DOC
  fileUrl  String
  fileName String?
  fileSize Int? // in bytes

  geoTag     Json? // { lat: number, lng: number }
  capturedAt DateTime? // When the photo/video was taken

  uploadedBy   BigInt // User ID
  uploaderRole String // INVESTOR, INSPECTOR

  createdAt DateTime @default(now())

  @@index([inspectionId])
  @@map("inspection_evidence")
}

// 6. Checklist Response (Inspector's answers to checklist items)
model InspectionChecklistResponse {
  id           String                @id @default(uuid())
  inspectionId String
  inspection   InspectionTransaction @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  checklistItemId Int

  response     String // Text answer or compliance status (COMPLIANT, NON_COMPLIANT, PARTIALLY_COMPLIANT, NOT_APPLICABLE)
  remarks      String? // Additional notes
  evidenceUrls String[] // References to uploaded evidence

  // JD Approval
  isApproved      Boolean @default(true)
  rejectionReason String?

  respondedBy BigInt // Inspector user ID
  respondedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, checklistItemId])
  @@index([inspectionId])
  @@map("inspection_checklist_responses")
}

// 7. Inspection Feedback (Investor rating)
model InspectionFeedback {
  id           String                @id @default(uuid())
  inspectionId String                @unique
  inspection   InspectionTransaction @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  rating  Int // 1-5 stars
  comment String?

  submittedBy BigInt // Investor user ID
  submittedAt DateTime @default(now())

  @@map("inspection_feedback")
}

// 8. Audit Log (for compliance and tracking)
model InspectionAuditLog {
  id           String                @id @default(uuid())
  inspectionId String
  inspection   InspectionTransaction @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  action    String // STATUS_CHANGE, EVIDENCE_UPLOAD, OBSERVATION_ADDED, REPORT_PUBLISHED, etc.
  fromValue String?
  toValue   String?
  details   Json? // Additional context

  performedBy BigInt // User who performed the action
  performedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([inspectionId])
  @@index([performedAt])
  @@map("inspection_audit_logs")
}

model InformationWizard {
  id                      Int      @id @default(autoincrement())
  serviceId               Int      @unique @map("service_id")
  statuaryFormPath        String?  @map("statuary_form_path") @db.VarChar(255)
  feeStructurePath        String?  @map("fee_structure_path") @db.VarChar(255)
  sopDocumentPath         String?  @map("sop_document_path") @db.VarChar(255)
  stageWiseTimelinePath   String?  @map("stage_wise_timeline_path") @db.VarChar(255)
  statuaryTimelinePath    String?  @map("statuary_timeline_path") @db.VarChar(255)
  statuaryTimelineText    String?  @map("statuary_timeline_text") @db.VarChar(255)
  inspectionChecklistPath String?  @map("inspection_checklist_path") @db.VarChar(255)
  riskCategory            String?  @map("risk_category") @db.Text
  sizeOfFirm              String?  @map("size_of_firm") @db.Text
  businessLocation        String?  @map("business_location") @db.Text
  investorType            String?  @map("investor_type") @db.Text
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("m_information_wizard")
}

// ------------------------------------------------------
// APPLICATION WORKFLOW & TRANSACTION TABLES
// ------------------------------------------------------

enum ProcessingLevel {
  District
  State
}

enum WorkflowConfigStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  ARCHIVED
}

enum JurisdictionLevel {
  STATE
  DISTRICT
  BLOCK
  TEHSIL
  GRAM_PANCHAYAT
  VILLAGE
}

enum AssignmentStrategy {
  ROLE
  USER
  OFFICE
  RULE
}

model ApplicationWorkflowConfiguration {
  id                         Int                  @id @default(autoincrement())
  step                       Int                  @default(0)
  departmentId               Int                  @map("department_id")
  serviceId                  String               @map("service_id") @db.VarChar(20)
  configVersion              Int                  @default(1) @map("config_version")
  status                     WorkflowConfigStatus @default(DRAFT) @map("status")
  startDate                  DateTime             @default(now()) @map("start_date")
  endDate                    DateTime?            @map("end_date")
  roleId                     Int                  @default(0) @map("role_id")
  jurisdictionLevelId        Int?                 @map("jurisdiction_level_id")
  assignmentStrategyId       Int?                 @map("assignment_strategy_id")
  actionMasterIdsJson        Json                 @default("[]") @map("action_master_ids_json") @db.JsonB
  jurisdictionLevel          JurisdictionLevel    @default(DISTRICT) @map("jurisdiction_level")
  assignmentStrategy         AssignmentStrategy   @default(ROLE) @map("assignment_strategy")
  assignmentRuleJson         Json?                @map("assignment_rule_json") @db.JsonB
  actionAllowedJson          Json                 @default("[]") @map("action_allowed_json") @db.JsonB
  transitionMapJson          Json                 @default("{}") @map("transition_map_json") @db.JsonB
  slaHours                   Int                  @default(0) @map("sla_hours")
  slaBreachRequiresReason    Boolean              @default(true) @map("sla_breach_requires_reason")
  nextAllocationRoleId       Int?                 @map("next_allocation_role_id")
  createdBy                  String?              @map("created_by") @db.VarChar(100)
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedBy                  String?              @map("updated_by") @db.VarChar(100)
  updatedAt                  DateTime             @default(now()) @updatedAt @map("updated_at")
  processingLevel            ProcessingLevel      @default(District) @map("processing_level")
  currentRoleId              Int                  @map("current_role_id")
  formTypeId                 Int                  @map("form_type_id")
  nextRoleId                 Int                  @map("next_role_id")
  approverId                 Int                  @map("approver_id")
  forwardRoleId              Int                  @map("forward_role_id")
  revertRoleId               Int                  @map("revert_role_id")
  isDelayReasonRequired      ActiveStatus         @default(N) @map("is_delay_reason_required")
  timeInHours                String               @default("0") @map("time_in_hours") @db.VarChar(10)
  canRevertToInvestor        ActiveStatus         @default(N) @map("can_revert_to_investor")
  canVerifyDocument          ActiveStatus         @default(N) @map("can_verify_document")
  canForwardToMultipleRoleId String?              @map("can_forward_to_multiple_role_id") @db.VarChar(255)
  canForwardToMultipleUserId String?              @map("can_forward_to_multiple_user_id") @db.VarChar(255)
  isOwnDepartment            ActiveStatus         @default(N) @map("is_own_department")
  permissableTabFormId       String               @map("permissable_tab_form_id") @db.VarChar(255)
  documentShowLast           ActiveStatus         @default(N) @map("document_show_last")
  processAnytime             ActiveStatus         @default(N) @map("process_anytime")
  showLiceneceList           String               @default("0") @map("show_licenece_list") @db.Char(1)
  showFieldEditableOrNot     String               @default("0") @map("show_field_editable_or_not") @db.Char(1)
  formServiceJs              String               @default("") @map("form_service_js") @db.VarChar(255)
  formActionController       String               @default("") @map("form_action_controller") @db.VarChar(255)
  subformActionName          String               @map("subform_action_name") @db.VarChar(255)
  licenceNumberFormat        String?              @map("licence_number_format") @db.VarChar(255)

  department               Department?                       @relation(fields: [departmentId], references: [id])
  service                  Service?                          @relation(fields: [serviceId], references: [service_id])
  formType                 FormType?                         @relation(fields: [formTypeId], references: [id])
  jurisdictionLevelMaster  WorkflowJurisdictionLevelMaster?  @relation(fields: [jurisdictionLevelId], references: [id])
  assignmentStrategyMaster WorkflowAssignmentStrategyMaster? @relation(fields: [assignmentStrategyId], references: [id])

  @@index([departmentId])
  @@index([serviceId])
  @@index([formTypeId])
  @@index([jurisdictionLevelId])
  @@index([assignmentStrategyId])
  @@index([serviceId, configVersion, status])
  @@index([serviceId, step, status])
  @@index([roleId, jurisdictionLevel, status])
  @@map("c_application_workflow_configuration")
}

