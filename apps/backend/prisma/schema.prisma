  @@map("m_service")
}

enum ServiceStatus {
  ONLINE_ON_DEPT_PORTAL
  INTEGRATED
  ONBOARDED
  OFFLINE
  NOT_APPLICABLE
  INCENTIVE
}

enum DocumentStatus {
  U // Unverified
  V // Verified
  R // Rejected
  M // Mismatched

  @@map("document_status")
}

enum ActiveStatus {
  Y // Yes
  N // No

  @@map("active_status")
}

